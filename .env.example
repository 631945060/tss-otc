# Leave MYSQL_DSN and REDIS_ADDR empty for the standalone in-memory demo.
HTTP_ADDR=:8080
STATIC_DIR=./web/admin-console
SHUTDOWN_TIMEOUT=10s

# MySQL enables startup migration execution.
# MYSQL_DSN=wallet:wallet@tcp(127.0.0.1:3306)/tss_wallet?charset=utf8mb4&parseTime=true&loc=UTC
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5

# Redis enables the signing-session event Stream and its consumer.
# REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
